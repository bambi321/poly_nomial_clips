# ─────────────────────────────────────────────
# Episodes: commit the .md notes, keep each episode's video and data local
#   episodes/<name>/media/    downloaded video, metadata, word timings
#   episodes/<name>/renders/  finished vertical clips
# (the media/ and renders/ rules below cover these at any depth)
# ─────────────────────────────────────────────
episodes/*/media/
episodes/*/renders/

# ─────────────────────────────────────────────
# Working folders for downloads and renders
# ─────────────────────────────────────────────
downloads/
raw/
renders/
exports/
media/
tmp/
scratch/

# ─────────────────────────────────────────────
# Secrets and API keys (YouTube, Instagram, TikTok, etc.)
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
client_secret*.json
token*.json
*cookies*.txt

# ─────────────────────────────────────────────
# Claude Code: share skills/settings, keep personal overrides local
# ─────────────────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md

